{
	"name": "sv-matrix",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"create:square": "node scripts/create-square.mjs",
		"create:circle": "node scripts/create-circle.mjs",
		"create:squares": "node scripts/create-square-range.mjs",
		"create:circles": "node scripts/create-circle-range.mjs",
		"build:loaders": "pnpm shadcn-svelte registry build",
		"build:blocks": "pnpm shadcn-svelte registry build ./loaders.json -o ./static/r"
	},
	"devDependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@shikijs/langs": "^4.0.2",
		"@shikijs/themes": "^4.0.2",
		"@sveltejs/adapter-auto": "latest",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"clsx": "^2.1.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.2.7",
		"shiki": "^4.0.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-meta-tags": "^4.6.0",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"jsrepo": "^3.7.0"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"bits-ui": "2.16.3",
		"mode-watcher": "^1.1.0",
		"motion-sv": "^0.1.12",
		"package-manager-detector": "^1.6.0",
		"svelte-sonner": "^1.1.1"
	}
}
